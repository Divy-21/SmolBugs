# Copy this file to .env for local development: cp .env.example .env
# These values are for the local Docker database only. Real ones live in AWS.

DATABASE_URL="postgresql://smolbugs:smolbugs@localhost:5433/smolbugs?schema=public"

# Keys a device or gateway must send in the x-device-key header. Comma-separated.
DEVICE_KEYS="dev-key-change-me"
